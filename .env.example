# Docker User Configuration
UID=1000
GID=1000

# PostgreSQL Configuration
POSTGRES_USER=flightops
POSTGRES_PASSWORD=changeme-in-production
POSTGRES_DB=flightops
POSTGRES_PORT=5432
POSTGRES_DATA_PATH=./postgres_data
BACKUP_DIR=./backups

# Backend Configuration
JWT_SECRET=changeme-in-production-use-strong-random-string
JWT_EXPIRATION=7d

# General Configuration
TIMEZONE=UTC

# Media Storage Configuration
MEDIA_STORAGE_PATH=./media
MAX_UPLOAD_SIZE=2147483648

# GPX / Flight Analysis Configuration
MAX_GPX_UPLOAD_SIZE=52428800
ANALYSIS_SCORING_VERSION=1.0
# MAPTILER_API_KEY=           # Optional: for MapLibre terrain tiles (Phase 4)
# CESIUM_ION_TOKEN=           # Optional: future 3D globe mode

# Frontend Configuration
VITE_API_BASE_URL=/api
